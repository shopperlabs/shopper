{
  "name": "shopper/http",
  "description": "Shopper HTTP infrastructure, shared middleware, route helpers, and API configuration",
  "license": "MIT",
  "authors": [
    {
      "name": "Arthur Monney",
      "email": "monneylobe@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/auth": "^12.45|^13.0",
    "illuminate/cache": "^12.45|^13.0",
    "illuminate/contracts": "^12.45|^13.0",
    "illuminate/database": "^12.45|^13.0",
    "illuminate/http": "^12.45|^13.0",
    "illuminate/routing": "^12.45|^13.0",
    "illuminate/support": "^12.45|^13.0",
    "illuminate/validation": "^12.45|^13.0",
    "laravel/sanctum": "^4.0",
    "shopper/core": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Http\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Http\\HttpServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
