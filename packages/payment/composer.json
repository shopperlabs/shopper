{
  "name": "shopper/payment",
  "description": "Shopper payment providers integration",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/broadcasting": "^12.68|^13.27",
    "illuminate/bus": "^12.68|^13.27",
    "illuminate/console": "^12.68|^13.27",
    "illuminate/contracts": "^12.68|^13.27",
    "illuminate/database": "^12.68|^13.27",
    "illuminate/queue": "^12.68|^13.27",
    "illuminate/support": "^12.68|^13.27",
    "shopper/core": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Payment\\": "src/",
      "Shopper\\Payment\\Database\\Factories\\": "database/factories"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Payment\\PaymentServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
