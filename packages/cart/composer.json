{
  "name": "shopper/cart",
  "description": "Shopper cart management with pipeline-based calculation",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.45|^13.0",
    "illuminate/contracts": "^12.45|^13.0",
    "illuminate/database": "^12.45|^13.0",
    "illuminate/pipeline": "^12.45|^13.0",
    "illuminate/session": "^12.45|^13.0",
    "illuminate/support": "^12.45|^13.0",
    "shopper/core": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Cart\\": "src/",
      "Shopper\\Cart\\Database\\Factories\\": "database/factories"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Cart\\CartServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
