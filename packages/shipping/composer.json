{
  "name": "shopper/shipping",
  "description": "Shopper shipping providers integration",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/bus": "^12.45|^13.0",
    "illuminate/console": "^12.45|^13.0",
    "illuminate/contracts": "^12.45|^13.0",
    "illuminate/database": "^12.45|^13.0",
    "illuminate/http": "^12.45|^13.0",
    "illuminate/queue": "^12.45|^13.0",
    "illuminate/support": "^12.45|^13.0",
    "ivanmitrikeski/laravel-shipping": "^1.0",
    "shopper/core": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Shipping\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Shipping\\ShippingServiceProvider"
      ],
      "dont-discover": [
        "ivanmitrikeski/laravel-shipping"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
