{
  "name": "shopper/usps",
  "description": "USPS shipping driver for Shopper",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/http": "^12.68|^13.27",
    "illuminate/support": "^12.68|^13.27",
    "shopper/shipping": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Usps\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Usps\\UspsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
