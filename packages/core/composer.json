{
  "name": "shopper/core",
  "description": "Shopper e-commerce core functionality",
  "license": "MIT",
  "require": {
    "ext-intl": "*",
    "php": "^8.3",
    "giggsey/libphonenumber-for-php": "^9.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "laravel/scout": "^10.13",
    "league/csv": "^9.20",
    "spatie/laravel-package-tools": "^1.9",
    "staudenmeir/laravel-adjacency-list": "^1.0"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Shopper\\Core\\": "src/",
      "Shopper\\Core\\Database\\Factories\\": "database/factories",
      "Shopper\\Core\\Database\\Seeders\\": "database/seeders"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Core\\CoreServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
